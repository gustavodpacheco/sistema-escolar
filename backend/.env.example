PORT=3000

# Obrigatorio: chave usada para assinar/verificar os tokens JWT (16+ caracteres).
JWT_SECRET=troque-esta-chave-por-uma-longa-e-aleatoria

DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql
DB_NAME=sistema_escolar
DB_USER=root
DB_PASS=sua_senha

DB_RETRY_DELAY_MS=5000
DB_SYNC_FORCE=false

# Origens autorizadas a chamar a API (o dev server do Vite usa a porta 5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cotas de requisicao (por IP).
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=20
API_RATE_MAX=600

SEED_PASSWORD=123456
SEED_DADOS_DEMO=true
